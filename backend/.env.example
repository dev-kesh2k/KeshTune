PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/spotify_x
JWT_SECRET=
TZ=America/Sao_Paulo
PUBLIC_PATH=
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@spotifyx.app
# Senha do admin criado no primeiro boot (mín. 8 caracteres). Nunca coloque a senha real aqui: este arquivo é público.
SEED_ADMIN_PASSWORD=
# Importação do Spotify (spotDL): binário e opções extras, ex.: --client-id X --client-secret Y --ffmpeg /usr/bin/ffmpeg
SPOTDL_BIN=spotdl
SPOTDL_ARGS=
SPOTDL_TIMEOUT_MIN=180
# Busca no YouTube (opcional; sem chave usa o yt-dlp) e download do áudio pelo yt-dlp (vem com o spotDL)
YOUTUBE_API_KEY=
YTDLP_BIN=yt-dlp
YTDLP_ARGS=
# Conexões do Postgres por réplica (padrão 8)
DB_POOL_MAX=
# Proxies confiáveis para pegar o IP real (lista separada por vírgula; padrão: loopback)
TRUST_PROXY=
# Pasta de uploads (capas, áudio próprio, imagens); padrão ./uploads
UPLOAD_DIR=
# Horas que o áudio convertido do YouTube e o MP4 de vídeo ficam no servidor antes da limpeza (padrão 48)
OFFLOAD_AFTER_H=
VIDEO_KEEP_H=
